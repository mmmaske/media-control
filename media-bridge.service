[Unit]
Description=Workstation MQTT Media Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mmmaske
WorkingDirectory=/home/mmmaske/media-control
Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus"
Environment="XDG_RUNTIME_DIR=/run/user/1000"
ExecStart=/usr/bin/node /home/mmmaske/media-control/media-bridge.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
